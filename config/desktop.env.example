SIGNAL_MODE=lan
LAN_LISTEN=:8088
LAN_PASSWORD=
SIGNAL_NAME=RemyDesk
SOURCE_MODE=command
H264_WORKDIR=/opt/remydesk/libexec
H264_COMMAND=exec ./portable_h264_stream.sh
# stdout is universally compatible. On the native RK3399 MPP backend, shm
# removes the extra kernel-pipe copy between the encoder and publisher.
H264_TRANSPORT=stdout
H264_SHM_DIR=/run/remydesk
REMYDESK_VIDEO_BACKEND=auto
REMYDESK_DRM_DEVICE=auto
REMYDESK_DRM_DRIVER=rockchip
REMYDESK_VIDEO_FPS=60
REMYDESK_VIDEO_BITRATE=6000000
# The WebRTC H264_FMTP profile-level-id must match these encoder settings.
# Baseline/level 4.0: 42c028; Main/level 4.0: 4d0028.
REMYDESK_H264_PROFILE=baseline
REMYDESK_H264_LEVEL=40
REMYDESK_H264_CABAC=0
H264_FMTP=level-asymmetry-allowed=1;packetization-mode=1;profile-level-id=42c028
# Shared output size for the portable MPP and libx264 backends.
REMYDESK_VIDEO_WIDTH=1920
REMYDESK_VIDEO_HEIGHT=1080
# Some vendor gst-rockchip builds corrupt zero-copy output packets. The
# capability probe will still prefer a fully hardware path when it is stable.
REMYDESK_MPP_ZERO_COPY_PACKET=false
# Keep the MPP encoder unprivileged; only kmsgrab needs root on vendor images.
REMYDESK_MPP_USER=remydesk
REMYDESK_SOFTWARE_WIDTH=1280
REMYDESK_SOFTWARE_HEIGHT=720
FPS=60
H264_NAL_QUEUE=4
# Set to 0 to disable periodic healthy-stream counters. Errors and state
# transitions are always logged.
H264_STATS_LOG_SECONDS=30
# Native-MPP congestion control. RTCP receiver reports, NACKs, RTT and REMB
# adjust the encoder at most once per interval. Requires H264_TRANSPORT=shm.
H264_ADAPTIVE_BITRATE=0
H264_BITRATE_MIN=2000000
H264_BITRATE_MAX=8000000
H264_CC_INTERVAL_MS=1000
# Use wall-clock RTP timestamps when the encoder dynamically changes cadence.
H264_VARIABLE_FPS=false
# Optional native-MPP idle cadence. Input activity immediately restores the
# configured active FPS; independent screen changes are detected from encoded
# frame size without reading the DRM framebuffer back to the CPU.
REMYDESK_DYNAMIC_FPS=0
REMYDESK_IDLE_FPS=8
REMYDESK_IDLE_AFTER_MS=3000
REMYDESK_IDLE_FRAME_BYTES=12000
ICE_SERVERS=
INPUT_ENABLED=true
INPUT_WIDTH=1920
INPUT_HEIGHT=1080
AUDIO_ENABLED=true
AUDIO_BACKEND=pulse
AUDIO_SOURCE=auto
AUDIO_BITRATE=96k
AUDIO_THREAD_QUEUE_SIZE=8
PULSE_SERVER=auto
HDMI_REQUIRED_MODE=1920x1080
HDMI_FORCE_MODE=1
HDMI_XRANDR_OUTPUT=auto
HDMI_XRANDR_RATE=60
HDMI_DISPLAY=:0
HDMI_XAUTHORITY=auto
# RK3399 Firefly BSP 可在没有显示器或 HDMI 诱骗器时强制连接 HDMI。
# 仅在确认 /sys/class/drm/*HDMI*/status 支持写入 on 的板卡配置中启用。
REMYDESK_DRM_FORCE_CONNECTOR=0
REMYDESK_DRM_CONNECTOR_STATUS=auto
REMYDESK_DRM_CONNECTOR_SETTLE_SECONDS=2
