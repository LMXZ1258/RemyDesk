REMYDESK_VIDEO_BACKEND=native-mpp
REMYDESK_DRM_DEVICE=auto
REMYDESK_DRM_DRIVER=rockchip
REMYDESK_VIDEO_WIDTH=1280
REMYDESK_VIDEO_HEIGHT=720
REMYDESK_VIDEO_FPS=30
REMYDESK_VIDEO_BITRATE=3000000
REMYDESK_H264_PROFILE=baseline
REMYDESK_H264_LEVEL=40
REMYDESK_H264_CABAC=0
H264_FMTP=level-asymmetry-allowed=1;packetization-mode=1;profile-level-id=42c028
REMYDESK_MPP_ZERO_COPY_PACKET=false
REMYDESK_NATIVE_MPP_ZERO_COPY=1
REMYDESK_NATIVE_BUFFER_COUNT=1
REMYDESK_MPP_LEGACY_FPS_KEYS=1
LD_LIBRARY_PATH=/opt/remydesk/lib/rga-rk3399
REMYDESK_DRM_FORCE_CONNECTOR=1
REMYDESK_DRM_CONNECTOR_STATUS=auto
HDMI_REQUIRED_MODE=1280x720
HDMI_XRANDR_RATE=60
HDMI_XRANDR_OUTPUT=auto
INPUT_WIDTH=1280
INPUT_HEIGHT=720
