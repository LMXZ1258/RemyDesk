#!/usr/bin/env bash
set -euo pipefail

PID_FILE="${REMYDESK_DESKTOP_PID_FILE:-/run/remydesk/desktop.pid}"
LOG_FILE="${REMYDESK_DESKTOP_LOG_FILE:-/var/lib/remydesk/desktop.log}"
SERVICE_NAME="${REMYDESK_DESKTOP_SERVICE:-remydesk-desktop.service}"

enabled() {
  case "${REMYDESK_DESKTOP_AUTOSTART:-1}" in
    1|true|yes|on|enabled) return 0 ;;
    *) return 1 ;;
  esac
}

read_pid() {
  [[ -r "$PID_FILE" ]] || return 1
  local pid
  read -r pid <"$PID_FILE"
  [[ "$pid" =~ ^[1-9][0-9]*$ ]] || return 1
  printf '%s\n' "$pid"
}

running() {
  local pid
  pid="$(read_pid 2>/dev/null)" || return 1
  kill -0 "$pid" 2>/dev/null
}

start_desktop() {
  if running; then
    return 0
  fi
  rm -f "$PID_FILE"
  mkdir -p "$(dirname "$PID_FILE")" "$(dirname "$LOG_FILE")"

  HDMI_MODE_WAIT_SECONDS="${HDMI_MODE_WAIT_SECONDS:-5}" \
    /opt/remydesk/libexec/remydesk-display-mode.sh >>"$LOG_FILE" 2>&1 || true

  (
    cd /opt/remydesk/libexec
    exec setsid /opt/remydesk/bin/remydesk-webrtc-publisher
  ) >>"$LOG_FILE" 2>&1 </dev/null &
  local pid="$!"
  printf '%s\n' "$pid" >"$PID_FILE"
  sleep 0.15
  if ! kill -0 "$pid" 2>/dev/null; then
    rm -f "$PID_FILE"
    tail -n 30 "$LOG_FILE" >&2 || true
    return 1
  fi
}

stop_desktop() {
  local pid
  pid="$(read_pid 2>/dev/null)" || {
    rm -f "$PID_FILE"
    return 0
  }
  if kill -0 "$pid" 2>/dev/null; then
    kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
    for _ in {1..40}; do
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.1
    done
    if kill -0 "$pid" 2>/dev/null; then
      kill -KILL -- "-$pid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null || true
    fi
  fi
  rm -f "$PID_FILE"
}

action=""
for argument in "$@"; do
  case "$argument" in
    start|stop|restart|is-active|is-enabled|poweroff) action="$argument"; break ;;
    "$SERVICE_NAME") ;;
  esac
done

case "$action" in
  start)
    start_desktop
    ;;
  stop)
    stop_desktop
    ;;
  restart)
    stop_desktop
    start_desktop
    ;;
  is-active)
    if running; then
      echo active
    else
      echo inactive
      exit 3
    fi
    ;;
  is-enabled)
    if enabled; then
      echo enabled
    else
      echo disabled
      exit 1
    fi
    ;;
  poweroff)
    [[ -n "${REMYDESK_CONTAINER_INIT_PID:-}" ]] || {
      echo "container init pid is unavailable" >&2
      exit 1
    }
    kill -TERM "$REMYDESK_CONTAINER_INIT_PID"
    ;;
  *)
    echo "unsupported container service action: $*" >&2
    exit 2
    ;;
esac
